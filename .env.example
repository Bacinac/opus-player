# Copy to .env. Only infra bootstrap lives here — DIDA and the sound are set at
# runtime through the Settings page and stored in Postgres.

# Where OPUS · Library answers, and the token it is asked with (the Player
# token on Library's account page). Required: everything the player shows and
# everybody it lets in is asked of Library. The house's automation calls this
# module with a token of its own, issued on the house settings page. The backend
# refuses to start without either.
#   OPUS_LIBRARY_URL=http://192.0.2.10:8095
OPUS_LIBRARY_URL=
OPUS_LIBRARY_TOKEN=

# What sessions are signed with. Required, and the SAME value in Library,
# Downloads and Player: a session any of them issues is read by all three, and
# the car bearers and play tickets this module hands out are signed with it too.
# The backend refuses to start without it.

# UID/GID used by the Player application process. The artwork cache must be
# owned by this identity before switching an existing installation to non-root.
# OPUS_APP_UID=1000
# OPUS_APP_GID=1000
# First review `./deploy/prod.sh --prepare-volumes`; run it with `--apply`
# only in the planned rollout that enables the non-root backend.
#   python -c "import secrets; print(secrets.token_hex(32))"
OPUS_SESSION_KEY=

# The password of this module's own Postgres, which the backend's database
# address is built from. Required. Hex, so it goes into that address unescaped.
# Changing it on an existing database is an ALTER ROLE opus PASSWORD inside the
# postgres container first: the value here is only read when the data dir is new.
#   python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=

# The domain the three modules share a session on, when they are published
# under one (opus.example.com and library.example.com share example.com).
# Unset keeps the cookie on the host that issued it — right for a LAN address.
# OPUS_COOKIE_DOMAIN=example.com

# Dev shapes (Vite dev server + HMR, uvicorn --reload). Leave unset for
# production: built UI (adapter-node + /api proxy) and plain uvicorn.
# OPUS_UI_TARGET=dev
# OPUS_DEV_RELOAD=1
# The hostname a tunnel publishes the dev server at, when it is opened from
# beyond the LAN; hot reload then runs over the tunnel's TLS as well.
# OPUS_DEV_HOST=opus-dev.example.com

# Container resource ceilings. Defaults fit the application services on the
# 32 GiB host; increase a value only for a measured workload.
# OPUS_BACKEND_MEMORY_LIMIT=3g
# OPUS_BACKEND_PIDS_LIMIT=512
# OPUS_DAC_MEMORY_LIMIT=512m
# OPUS_DAC_PIDS_LIMIT=64
# OPUS_FRONTEND_MEMORY_LIMIT=512m
# OPUS_FRONTEND_PIDS_LIMIT=128
# OPUS_DATABASE_MEMORY_LIMIT=2g
# OPUS_DATABASE_PIDS_LIMIT=128

# Where the other OPUS modules answer, for the shell's module switcher. Unset
# means "not deployed here" and that module stays out of the switcher.
# VITE_OPUS_LIBRARY_URL=https://library.example.com
# VITE_OPUS_DOWNLOADS_URL=https://downloads.example.com

# The render node the transcoder uses. Unset gives the backend no GPU, and
# transcoding then fails rather than falling back to the CPU.
# OPUS_RENDER_DEVICE=/dev/dri/renderD129
# The numeric group that owns that node on this host (`stat -c %g <node>`); the
# backend runs without root and opens the node through this group.
# OPUS_RENDER_GID=993

# The DAC the stereo output plays into: the ALSA id of the card (the name in
# brackets in /proc/asound/cards) and the directory its nodes live in. Required.
# "none" plays into nothing at real-time speed — a box without the DAC. A card
# that is named and not plugged in keeps the dac container down.
#   production: OPUS_DAC_CARD=Audio and OPUS_DAC_SOUND=/dev/snd
OPUS_DAC_CARD=none
# OPUS_DAC_SOUND=/dev/snd

# How much fetched artwork is kept on disk before the pictures looked at longest
# ago are let go. Unset keeps two gibibytes.
# OPUS_ART_CACHE_BYTES=2147483648

# The libraries, under the names Library's paths use (compose named volumes).
# Unset falls back to the in-repo ./volumes/* folders.
#
# Libraries on this machine — local binds:
# OPUS_MUSIC_VOLUME_TYPE=none
# OPUS_MUSIC_VOLUME_OPTS=bind
# OPUS_MUSIC_DEVICE=/mnt/media/music
# OPUS_PHOTOS_VOLUME_TYPE=none
# OPUS_PHOTOS_VOLUME_OPTS=bind
# OPUS_PHOTOS_DEVICE=/mnt/media/photos
# OPUS_MOVIES_VOLUME_TYPE=none
# OPUS_MOVIES_VOLUME_OPTS=bind
# OPUS_MOVIES_DEVICE=/mnt/media/movies
# OPUS_TV_VOLUME_TYPE=none
# OPUS_TV_VOLUME_OPTS=bind
# OPUS_TV_DEVICE=/mnt/media/television
# OPUS_VIDEO_VOLUME_TYPE=none
# OPUS_VIDEO_VOLUME_OPTS=bind
# OPUS_VIDEO_DEVICE=/mnt/media/video

# The front proxies this box is reached through (for example a Cloudflare
# tunnel connector and a reverse proxy on the LAN).
# Only from them is a forwarded client address believed; every other caller is
# known by its own socket address.
# OPUS_TRUSTED_PROXIES=192.0.2.100,192.0.2.101
