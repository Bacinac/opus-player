{
	"id": "/",
	"name": "OPUS · Player",
	"short_name": "Player",
	"description": "Reprodukcija OPUS biblioteke na uređaju koji je pri ruci.",
	"lang": "hr",
	"dir": "ltr",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"background_color": "#0e1213",
