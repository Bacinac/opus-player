		{ "src": "/icon-512.png?v=20260921", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{ "src": "/icon-maskable-192.png?v=20260921", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
		{ "src": "/icon-maskable-512.png?v=20260921", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
	]
